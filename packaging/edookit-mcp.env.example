# /etc/edookit-mcp/edookit-mcp.env — runtime config for the systemd service.
# Edit, then: sudo systemctl restart edookit-mcp
# Mode 0640, owner root:edookit-mcp (conffile — not overwritten on upgrade).

# Required: Edookit account used for scraping.
EDOOKIT_URL=https://your-school-login.edookit.net
EDOOKIT_USER=
EDOOKIT_PASS=

# Server install: keep chromium headless, cache the session cookie under the
# systemd-managed CacheDirectory so restarts don't relaunch chromium each time.
EDOOKIT_HEADLESS_LOGIN=true
EDOOKIT_COOKIE_CACHE=/var/cache/edookit-mcp/cookies.json

# Bundled PDFium library installed by the package (for attachment rasterization).
EDOOKIT_PDFIUM_LIB=/usr/lib/edookit-mcp/libpdfium.so

# --- HTTP transport gate — REQUIRED to run as a remote connector ------------
# /mcp is protected by a single static bearer token (constant-time compared).
# The HTTP transport refuses to start without it, so /mcp is never exposed with
# no protection at all. There is NO built-in OAuth/identity — put TLS + your own
# auth/VPN in front if you expose this beyond loopback.
# EDOOKIT_API_TOKEN=replace-me   # openssl rand -base64 24  (>= 16 chars)
#   clients then send:  Authorization: Bearer <that token>
#
# Optional: bind off loopback (front it with TLS) + allow the public Host behind
# a Host-preserving reverse proxy (rmcp DNS-rebinding guard is loopback-only by
# default).
# EDOOKIT_BIND_NON_LOOPBACK=true
# EDOOKIT_ALLOWED_HOST=edookit.mcp.example
