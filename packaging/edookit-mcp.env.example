# /etc/edookit-mcp/edookit-mcp.env — runtime config for the systemd service.
# Edit, then: sudo systemctl restart edookit-mcp
# Mode 0640, owner root:edookit-mcp (conffile — not overwritten on upgrade).

# Required: Edookit account used for scraping.
EDOOKIT_URL=https://your-school-login.edookit.net
EDOOKIT_USER=
EDOOKIT_PASS=

# Server install: keep chromium headless, cache the session cookie under the
# systemd-managed CacheDirectory so restarts don't relaunch chromium each time.
EDOOKIT_HEADLESS_LOGIN=true
EDOOKIT_COOKIE_CACHE=/var/cache/edookit-mcp/cookies.json

# Persist OAuth DCR client registrations + refresh tokens under the systemd
# StateDirectory so a restart/upgrade doesn't invalidate connected clients
# (otherwise they hit "unknown client_id" and must re-add the connector). The
# file holds refresh tokens and is written 0600. Set to "none" to disable.
EDOOKIT_OAUTH_STATE=/var/lib/edookit-mcp/oauth-state.json

# Bundled PDFium library installed by the package (for attachment rasterization).
EDOOKIT_PDFIUM_LIB=/usr/lib/edookit-mcp/libpdfium.so

# --- OAuth Authorization Server (HTTP transport) — all three REQUIRED -------
# Without these the HTTP transport refuses to start, so /mcp is never exposed
# unauthenticated. EDOOKIT_PUBLIC_URL must match what the reverse proxy serves.
# EDOOKIT_PUBLIC_URL=https://edookit.mcp.example
# EDOOKIT_AUTH_PASSWORD=replace-me-with-a-strong-passphrase
# EDOOKIT_JWT_SECRET=replace-me   # openssl rand -base64 48  (>= 32 bytes)
#
# Optional: expected login username (empty = any username, password decides).
# EDOOKIT_AUTH_USERNAME=you@example.com
