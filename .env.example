# Copy to .env and fill in (chmod 600 .env so the password isn't world-readable).
# Used by `make run` / `make smoke-login` / `make test-messages`, and by MCP
# hosts that pass these as the server's environment.

EDOOKIT_URL=https://your-school-login.edookit.net
EDOOKIT_USER=vase.jmeno@example.cz
EDOOKIT_PASS=vase-heslo

# Optional: set to "false" to watch the chromium login window (debugging).
# Default: true.
# EDOOKIT_HEADLESS_LOGIN=true

# Optional: override where session cookies are cached between runs.
# Default: <UserCacheDir>/edookit-mcp/cookies.json
# EDOOKIT_COOKIE_CACHE=/path/to/cookies.json

# Optional: disable cookie persistence entirely (chromium launches every run).
# EDOOKIT_NO_COOKIE_CACHE=true

# Optional: school wall-clock timezone (IANA name) used to interpret Edookit's
# offset-less timestamps. Default: Europe/Prague.
# EDOOKIT_TIMEZONE=Europe/Prague

# Optional: override the bundled PDFium library path used to rasterize PDF
# attachments. `make build` fetches it into third_party/pdfium/; packages
# install it under /usr/lib/edookit-mcp/. Normally you don't need to set this.
# EDOOKIT_PDFIUM_LIB=/path/to/libpdfium.so

# Optional: hosts an attachment download may be redirected to, on top of your
# EDOOKIT_URL origin. Edookit serves uploaded files from its own storage CDN —
# /handler/download/file<uuid> 302s to https://dataN.edookit.net/v1/fetch/... —
# and without this the redirect looks like a session bounce ("download bounced
# off-origin ..."). Comma-separated; exact hostnames or *.suffix wildcards
# (subdomains only). Applies to downloads ONLY: /handler/* JSON calls stay
# strictly same-origin, and an https origin never follows a redirect to http.
# Set it to an empty value to forbid every off-origin download redirect.
EDOOKIT_DOWNLOAD_HOSTS=*.edookit.net

# Optional: allow a plain http:// EDOOKIT_URL to a non-loopback host (off by
# default — http would put the session cookie on the wire in the clear).
# EDOOKIT_ALLOW_INSECURE_HTTP=false

# Optional (experimental): expose the MCP Apps UI (SEP-1865) for the inbox — the
# io.modelcontextprotocol/ui extension, a predeclared ui://edookit/inbox template
# (text/html;profile=mcp-app), and _meta.ui.resourceUri + structuredContent on
# edookit_list_inbox. MCP Apps–capable hosts render a clickable inbox (click a
# row → opens the message). On by default; the plain JSON output is unaffected
# and stays the source of truth. Set to "false" to disable the whole UI surface.
# EDOOKIT_UI_RESOURCES=true

# --- Remote (Streamable HTTP) mode -----------------------------------------
# For normal local MCP hosts (Claude Desktop/Code, Cursor, …) leave these unset
# — the default transport is stdio. To run as a remote connector, set
# EDOOKIT_HTTP_ADDR (or pass --http 127.0.0.1:9000). /mcp is gated by a single
# static bearer token; the HTTP transport refuses to start without it, so the
# endpoint is never exposed completely unprotected. There is NO built-in
# OAuth/identity — front it with your own TLS + auth/VPN if you expose it.
#   EDOOKIT_HTTP_ADDR=127.0.0.1:9000
#   EDOOKIT_API_TOKEN=...openssl rand -base64 24 (>= 16 chars)...
#     clients then send:  Authorization: Bearer <that token>
#
# Optional: bind off loopback (requires you front it with TLS) and, behind a
# Host-preserving reverse proxy, allow the public hostname (rmcp's DNS-rebinding
# guard is loopback-only by default):
#   EDOOKIT_BIND_NON_LOOPBACK=true
#   EDOOKIT_ALLOWED_HOST=edookit.mcp.example
