# Copy to .env and fill in (chmod 600 .env so the password isn't world-readable).
# Used by `make run` / `make smoke-login` / `make test-messages`, and by MCP
# hosts that pass these as the server's environment.

EDOOKIT_URL=https://your-school-login.edookit.net
EDOOKIT_USER=vase.jmeno@example.cz
EDOOKIT_PASS=vase-heslo

# Optional: set to "false" to watch the chromium login window (debugging).
# Default: true.
# EDOOKIT_HEADLESS_LOGIN=true

# Optional: override where session cookies are cached between runs.
# Default: <UserCacheDir>/edookit-mcp/cookies.json
# EDOOKIT_COOKIE_CACHE=/path/to/cookies.json

# Optional: disable cookie persistence entirely (chromium launches every run).
# EDOOKIT_NO_COOKIE_CACHE=true

# Optional: school wall-clock timezone (IANA name) used to interpret Edookit's
# offset-less timestamps. Default: Europe/Prague.
# EDOOKIT_TIMEZONE=Europe/Prague

# Optional: override the bundled PDFium library path used to rasterize PDF
# attachments. `make build` fetches it into third_party/pdfium/; packages
# install it under /usr/lib/edookit-mcp/. Normally you don't need to set this.
# EDOOKIT_PDFIUM_LIB=/path/to/libpdfium.so

# Optional: allow a plain http:// EDOOKIT_URL to a non-loopback host (off by
# default — http would put the session cookie on the wire in the clear).
# EDOOKIT_ALLOW_INSECURE_HTTP=false

# Optional (experimental): return an MCP-UI widget resource (ui://edookit/inbox,
# text/html) from edookit_list_inbox so MCP-UI–capable clients can render a
# clickable inbox (click a row → opens the message). On by default; the JSON
# output is unaffected and stays the source of truth. Set to "false" to suppress
# the widget — e.g. on clients that forward all content blocks to the model,
# where the extra HTML would also land in the model's context.
# EDOOKIT_UI_RESOURCES=true

# --- Remote (Streamable HTTP) mode -----------------------------------------
# For normal local MCP hosts (Claude Desktop/Code, Cursor, …) leave these unset
# — the default transport is stdio. To run as a remote connector, set
# EDOOKIT_HTTP_ADDR (or pass --http 127.0.0.1:9000). The HTTP transport refuses
# to start without the three OAuth vars below, so /mcp is never exposed without
# auth. See packaging/edookit-mcp.env.example and the README for the full set:
#   EDOOKIT_HTTP_ADDR=127.0.0.1:9000
#   EDOOKIT_PUBLIC_URL=https://edookit.mcp.example
#   EDOOKIT_AUTH_PASSWORD=...strong passphrase for the login form...
#   EDOOKIT_JWT_SECRET=...openssl rand -base64 48 (>= 32 bytes)...
#   EDOOKIT_AUTH_USERNAME=you@example.com   (optional)
